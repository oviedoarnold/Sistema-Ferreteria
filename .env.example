# Copia este archivo como .env.local y rellena los valores de tu proyecto.
# Se obtienen en Supabase -> Project Settings -> API Keys
#
# La clave publicable es publica por diseno: va compilada dentro del
# JavaScript que descarga cualquier visitante, y las politicas de acceso
# de la base son las que limitan lo que puede ver cada usuario.
#
# NUNCA pongas aqui la clave secreta (sb_secret_...): se salta todas las
# politicas y daria acceso total a la base a cualquiera que abra la pagina.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
